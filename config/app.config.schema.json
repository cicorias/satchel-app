{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Satchel app config",
  "type": "object",
  "required": ["name", "slug", "version", "apple", "web"],
  "properties": {
    "name": {
      "type": "string",
      "description": "Product name: the label under the iOS icon (CFBundleDisplayName) and the extension name. Keep it short"
    },
    "slug": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    },
    "version": {
      "type": "string",
      "pattern": "^20[0-9]{2}\\.(1[0-2]|[1-9])\\.(0|[1-9][0-9]*)$",
      "description": "CalVer YYYY.M.PATCH (ADR-0015)"
    },
    "repo": {
      "type": "string"
    },
    "siteUrl": {
      "type": "string",
      "format": "uri"
    },
    "apple": {
      "type": "object",
      "required": [
        "bundleId",
        "shareExtensionBundleId",
        "safariExtensionBundleId",
        "appGroup",
        "iCloudContainer",
        "keychainGroupSuffix",
        "urlScheme",
        "deploymentTarget"
      ],
      "properties": {
        "appStoreName": {
          "type": "string",
          "description": "The App Store listing name, set in App Store Connect. It must be unique in the store, so it can differ from `name`. Not compiled into the app"
        },
        "teamName": {
          "type": "string",
          "description": "Used to look up the Team ID from Xcode; the ID itself lives in config/local.config.json"
        },
        "bundleId": {
          "type": "string"
        },
        "shareExtensionBundleId": {
          "type": "string"
        },
        "safariExtensionBundleId": {
          "type": "string"
        },
        "appGroup": {
          "type": "string",
          "pattern": "^group\\."
        },
        "iCloudContainer": {
          "type": "string",
          "pattern": "^iCloud\\."
        },
        "keychainGroupSuffix": {
          "type": "string"
        },
        "urlScheme": {
          "type": "string"
        },
        "deploymentTarget": {
          "type": "object"
        },
        "cloudKitZone": {
          "type": "string"
        }
      }
    },
    "web": {
      "type": "object"
    }
  }
}
