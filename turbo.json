{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["DEVELOPMENT_TEAM", "BUILD_NUMBER"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build", "build"],
      "outputs": []
    }
  }
}
