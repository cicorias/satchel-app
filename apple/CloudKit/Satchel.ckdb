// CloudKit schema for iCloud.com.cedarlogic.satchel (spec §8.2), in CloudKit Schema Language.
// This file is the source of truth: change it here, then `mise run deploy:cloudkit-schema import`.
// Import only reaches Development; Production is deployed from CloudKit Console (Phase 7).
// Fields can't be removed or retyped once deployed to Production, so treat every field as permanent.
// Keep CloudKit's export order (record types, then fields, alphabetical after the ___ system fields)
// so `mise run deploy:cloudkit-schema diff` shows only real changes.
//
// Item: record name = Item.id ("u_" + 32 hex of SHA-256(normalizedUrl), spec §7.1). `source` and `page`
// are JSON-encoded objects, and `selection` is a boolean stored as 0/1 (FR-10). Markdown goes in `body` when its
// UTF-8 size is ≤ 512 KB, otherwise in `bodyAsset`; writers set exactly one. Phase 5 adds RECORD TYPE ImageAsset.

DEFINE SCHEMA

    RECORD TYPE Item (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE QUERYABLE,
        author          STRING,
        body            STRING,
        bodyAsset       ASSET,
        canonicalUrl    STRING,
        capturedAt      TIMESTAMP,
        createdAt       TIMESTAMP SORTABLE,
        description     STRING,
        faviconUrl      STRING,
        imageUrl        STRING,
        kind            STRING QUERYABLE,
        lang            STRING,
        metadataStatus  STRING,
        normalizedUrl   STRING QUERYABLE,
        note            STRING,
        page            STRING,
        publishedAt     TIMESTAMP,
        schemaVersion   INT64,
        selection       INT64,
        siteName        STRING,
        source          STRING,
        tags            LIST<STRING> QUERYABLE,
        title           STRING,
        updatedAt       TIMESTAMP,
        url             STRING,
        GRANT WRITE TO "_creator",
        GRANT CREATE TO "_icloud",
        GRANT READ TO "_world"
    );

    RECORD TYPE Users (
        "___createTime" TIMESTAMP,
        "___createdBy"  REFERENCE,
        "___etag"       STRING,
        "___modTime"    TIMESTAMP,
        "___modifiedBy" REFERENCE,
        "___recordID"   REFERENCE,
        roles           LIST<INT64>,
        GRANT WRITE TO "_creator",
        GRANT READ TO "_world"
    );
